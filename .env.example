# Copy to .env and adjust. Never commit .env — it is gitignored.
#
# This file only lists what the code reads today; it grows with each ticket.
# The X account sessions live in Mongo, never in a versioned file (CLAUDE.md §5).

# Logging verbosity of the application's own loggers.
LOG_LEVEL=INFO

# OpenAPI metadata — what RapidAPI clients see at the top of the Swagger page.
API_TITLE=X Lookup API
API_VERSION=0.1.0
