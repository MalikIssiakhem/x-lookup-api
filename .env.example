# Copy to .env and adjust. Never commit .env — it is gitignored.
#
# This file only lists what the code reads today; it grows with each ticket.
# The X account sessions live in Mongo, never in a versioned file (CLAUDE.md §5).

# X account sessions — Mongo is the source of truth for the pool. Required, no
# default: a missing value stops the boot rather than silently pointing at some
# other database.
#
# Percent-encode the special characters of the password: & -> %26, ! -> %21,
# % -> %25. An unescaped one truncates the URI and the failure is unreadable.
#
# Left as the compose service name so `docker compose up` works out of the box.
X_SESSIONS_MONGODB_URL=mongodb://mongo:27017
X_SESSIONS_MONGODB_DB_NAME=x_sessions
X_SESSIONS_COLLECTION=sessions

# How often the in-memory pool is rebuilt from Mongo. The hot path never reads
# Mongo, so this is the only thing that picks up an account added or evicted by
# another process.
X_SESSIONS_POOL_REFRESH_SECONDS=300

# Logging verbosity of the application's own loggers.
LOG_LEVEL=INFO

# OpenAPI metadata — what RapidAPI clients see at the top of the Swagger page.
API_TITLE=X Lookup API
API_VERSION=0.1.0
