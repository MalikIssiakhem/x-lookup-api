# Normalise les fins de ligne : LF dans le dépôt, quelle que soit la machine.
# Sans ça, un script shell committé depuis Windows arrive en CRLF dans l'image
# Docker et l'entrypoint échoue avec un "no such file or directory" illisible.
* text=auto eol=lf

# Fichiers qui doivent rester en CRLF côté Windows.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaires : jamais de conversion.
*.png binary
*.jpg binary
*.ico binary
*.gz  binary
*.zip binary
